# MetaTrader generated binaries and logs
*.ex4
*.ex5
*.log
*.tmp
MQL5/Tester/
MQL4/Tester/

# Local secrets and machine-specific settings
secrets*.py
*.secret
*.pem
*.key
.env
.env.*

# OS/editor files
Thumbs.db
Desktop.ini
.vscode/

# Local archive copied from the PC/Claude workspace; never push this folder
_local_archive/
data/private/

# Current EA source copies contain embedded deployment credentials; keep local
# (src/ 전체 재귀 — antguard 등 하위 폴더 mq5 에도 동일 시크릿이 박혀 있음)
src/**/*.mq4
src/**/*.mq5

# Generated caches / active agent copy (agents/ 가 정본)
tools/__pycache__/
.claude/

# Generated backtest data and reports
incoming_backtests/
data/backtests/
reports/
